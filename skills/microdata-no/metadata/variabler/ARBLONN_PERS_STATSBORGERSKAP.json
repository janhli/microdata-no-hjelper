{
 "name": "ARBLONN_PERS_STATSBORGERSKAP",
 "temporality": "STATUS",
 "languageCode": "no",
 "sensitivityLevel": "PERSON_GENERAL",
 "populationDescription": "Variabelen omfatter alle arbeidsforhold meldt inn gjennom A-ordningen som SSB anser å være aktive i referanseperioden, uavhengig av alder og bosatt-status i Folkeregisteret. \n \n Arbeidsforhold innhentes også fra andre kilder (SKDs arbeidsforholds- og oppdragsregister (tidligere SFU) og vernepliktige). A-ordningen er hovedkilden til informasjon om arbeidsforhold.\n \n Observasjoner med verdiene 0 og uoppgitt (missing) er utelatt.",
 "subjectFields": [
  "A-ordningen",
  "Arbeid og lønn",
  "Arbeidsmarked",
  "Lønn",
  "Sysselsetting"
 ],
